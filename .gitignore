# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtualenvs — the shared one both app folders are run from
.venv/
venv/
env/

# Build output
dist/
build/
*.egg-info/
.eggs/

# PyInstaller
*.spec.bak

# Bundled binaries fetched at build time, never committed (ffmpeg is ~170 MB)
vendor/
**/vendor/

# Generated icons (re-created by create_icons.py)
icons/

# Recordings, in case anyone points the output folder at the repo
*.mp4
# ...except the promo video the README links to
!docs/media/*.mp4

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Dev cert (created by CI, never commit)
*.pfx

# Generated by CI from the PyInstaller folder build (MSI)
annotateVideo/installer/AppFiles.wxs
