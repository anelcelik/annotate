<!--
  MSIX package manifest for Screen Annotator Pro.

  Store identity (Casultra / Partner Center):
    Package Name : Casultra.ScreenAnnotatorPro
    Publisher    : CN=BD1D6788-5A7D-4A7F-9751-817381E6C28C
    Store ID     : 9NS87MQB29C7
    PFN          : Casultra.ScreenAnnotatorPro_38f0gytd267x6

  For Microsoft Store submission upload the UNSIGNED .msix —
  Partner Center re-signs it automatically with the Casultra cert.
  The self-signed cert in the CI workflow is only for local sideload testing.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Casultra.ScreenAnnotatorPro"
    Publisher="CN=BD1D6788-5A7D-4A7F-9751-817381E6C28C"
    Version="3.0.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Screen Annotator Pro</DisplayName>
    <PublisherDisplayName>Casultra</PublisherDisplayName>
    <Logo>Assets\StoreLogo.scale-100.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 (17763) minimum; tested on Windows 11 22H2 (22621) -->
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
    <!-- Required by Python 3.12 / PyInstaller native DLLs (vcruntime140*.dll).
         Windows will install this framework package automatically from the Store
         before launching the app, fixing the "internalpython312.dll not found" error. -->
    <PackageDependency
      Name="Microsoft.VCLibs.140.00"
      MinVersion="14.0.30704.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="ScreenAnnotatorPro"
      Executable="ScreenAnnotatorPro.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Screen Annotator Pro"
        Description="Draw on your screen like a whiteboard. Annotate anything in real time."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.scale-100.png"
        Square44x44Logo="Assets\Square44x44Logo.scale-100.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.scale-100.png"
          Square310x310Logo="Assets\Square310x310Logo.scale-100.png"
          Square71x71Logo="Assets\Square71x71Logo.scale-100.png"
          ShortName="Annotator Pro" />
        <uap:SplashScreen Image="Assets\SplashScreen.scale-100.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required for packaging a classic Win32 / PyInstaller executable -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
