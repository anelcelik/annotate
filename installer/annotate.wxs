<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX 4 installer definition for Screen Annotator Pro.
  Build: wix build installer/annotate.wxs -ext WixToolset.UI.wixext -arch x64 -o dist/ScreenAnnotatorPro-Setup.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="Screen Annotator Pro"
    Manufacturer="Anel Celik"
    Version="1.0.0.0"
    UpgradeCode="7E43C21B-856F-4D9A-B1C3-7E5F2A490D12"
    Language="1033"
    InstallerVersion="500"
    Scope="perMachine">

    <SummaryInformation Description="Screen Annotator Pro installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Screen Annotator Pro is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Minimal UI: license acceptance → install progress → finish -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />

    <!-- Icon shown in Add/Remove Programs -->
    <Icon Id="AppIcon" SourceFile="dist\ScreenAnnotatorPro.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK"    Value="https://github.com/anelcelik/annotate" />

    <!-- ── Install to %ProgramFiles%\Screen Annotator Pro ───────────────── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Screen Annotator Pro">
        <Component Id="MainExecutable" Guid="A2B3C4D5-E6F7-4801-9ABC-DEF012345678">
          <File Id="MainExe"
                Source="dist\ScreenAnnotatorPro.exe"
                Name="ScreenAnnotatorPro.exe"
                KeyPath="yes" />
          <!-- Desktop shortcut -->
          <Shortcut Id="DesktopShortcut"
                    Name="Screen Annotator Pro"
                    Description="Draw on your screen like a whiteboard"
                    Directory="DesktopFolder"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="no" />
          <!-- Start Menu shortcut -->
          <Shortcut Id="StartMenuShortcut"
                    Name="Screen Annotator Pro"
                    Description="Draw on your screen like a whiteboard"
                    Directory="ApplicationProgramsFolder"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="no" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Start Menu folder (removed cleanly on uninstall) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Screen Annotator Pro">
        <Component Id="ProgramMenuEntry" Guid="B3C4D5E6-F7A8-4912-BCDE-F01234567890">
          <RemoveFolder Id="ProgramMenuFolderRemove" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\ScreenAnnotatorPro"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ProgramMenuEntry" />
    </Feature>

  </Package>
</Wix>
