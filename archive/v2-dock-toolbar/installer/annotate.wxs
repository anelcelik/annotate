<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX 4 installer definition for Screen Annotator Pro.

  Build (CI does this automatically):
    wix harvest dir dist\ScreenAnnotatorPro\_internal -o installer\AppFiles.wxs ^
        -cg AppFiles -dr InternalFolder -srd -var var.SourceDir
    wix build installer\annotate.wxs installer\AppFiles.wxs ^
        -ext WixToolset.UI.wixext -arch x64 ^
        -o dist\ScreenAnnotatorPro-Setup.msi ^
        -d SourceDir=dist\ScreenAnnotatorPro\_internal

  Install flow:
    Welcome → License → Feature selection → Progress → Finish (+ Launch checkbox)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="Screen Annotator Pro"
    Manufacturer="Anel Celik"
    Version="3.0.1.0"
    UpgradeCode="7E43C21B-856F-4D9A-B1C3-7E5F2A490D12"
    Language="1033"
    InstallerVersion="500"
    Scope="perMachine">

    <SummaryInformation Description="Screen Annotator Pro installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Screen Annotator Pro is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- ── UI: Feature selection → Progress → Finish ────────────────────── -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />

    <!-- "Launch Screen Annotator Pro" checkbox on the Finish page -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Launch Screen Annotator Pro" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- Custom action: start the app after install when checkbox is ticked -->
    <CustomAction Id="LaunchApp"
                  FileRef="MainExe"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <!-- Wire the Finish button to the launch action -->
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- Icon shown in Add/Remove Programs -->
    <Icon Id="AppIcon" SourceFile="dist\ScreenAnnotatorPro\ScreenAnnotatorPro.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK"    Value="https://github.com/anelcelik/annotate" />

    <!-- ── Install to %ProgramFiles%\Screen Annotator Pro ───────────────── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Screen Annotator Pro">

        <!-- _internal subfolder — populated by harvested AppFiles component group -->
        <Directory Id="InternalFolder" Name="_internal" />

        <!-- Main launcher exe + Start Menu shortcut (always installed) -->
        <Component Id="MainExecutable" Guid="A2B3C4D5-E6F7-4801-9ABC-DEF012345678">
          <File Id="MainExe"
                Source="dist\ScreenAnnotatorPro\ScreenAnnotatorPro.exe"
                Name="ScreenAnnotatorPro.exe"
                KeyPath="yes" />
          <Shortcut Id="StartMenuShortcut"
                    Name="Screen Annotator Pro"
                    Description="Draw on your screen like a whiteboard"
                    Directory="ApplicationProgramsFolder"
                    WorkingDirectory="INSTALLFOLDER"
                    Target="[#MainExe]"
                    Advertise="no" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- Desktop shortcut — separate component so it can be toggled in the UI -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComp" Guid="C4D5E6F7-A8B9-0123-CDEF-012345678901">
        <Shortcut Id="DesktopShortcut"
                  Name="Screen Annotator Pro"
                  Description="Draw on your screen like a whiteboard"
                  Target="[#MainExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="no" />
        <RegistryValue Root="HKCU"
                       Key="Software\ScreenAnnotatorPro"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Start Menu folder (removed cleanly on uninstall) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Screen Annotator Pro">
        <Component Id="ProgramMenuEntry" Guid="B3C4D5E6-F7A8-4912-BCDE-F01234567890">
          <RemoveFolder Id="ProgramMenuFolderRemove" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\ScreenAnnotatorPro"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ── Feature tree shown in the installer UI ───────────────────────── -->
    <Feature Id="ProductFeature"
             Title="Screen Annotator Pro"
             Description="The main application and Start Menu shortcut."
             Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ProgramMenuEntry" />
      <!-- All runtime files harvested from dist\ScreenAnnotatorPro\_internal -->
      <ComponentGroupRef Id="AppFiles" />

      <Feature Id="DesktopShortcutFeature"
               Title="Desktop shortcut"
               Description="Add a shortcut to the Desktop."
               Level="1">
        <ComponentRef Id="DesktopShortcutComp" />
      </Feature>
    </Feature>

  </Package>
</Wix>
