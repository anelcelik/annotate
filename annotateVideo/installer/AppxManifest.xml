<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for Screen Annotator Pro.

  Store identity (Casultra / Partner Center) — SAME as installer/AppxManifest.xml
  at the repo root, on purpose: recording is now a feature of the one shipping
  app, not a separate package.
    Package Name : Casultra.ScreenAnnotatorPro
    Publisher    : CN=BD1D6788-5A7D-4A7F-9751-817381E6C28C
    Store ID     : 9NS87MQB29C7
    PFN          : Casultra.ScreenAnnotatorPro_38f0gytd267x6

  CI signs this build with a throwaway self-signed certificate for sideload
  testing (its subject has to match Publisher above exactly, or Windows treats
  the package as tampered with). For an actual Store submission, use the
  UNSIGNED .msix from the same build instead and let Partner Center sign it —
  do not upload the self-signed one.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  IgnorableNamespaces="uap rescap uap5">

  <Identity
    Name="Casultra.ScreenAnnotatorPro"
    Publisher="CN=BD1D6788-5A7D-4A7F-9751-817381E6C28C"
    Version="5.8.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Screen Annotator Pro</DisplayName>
    <PublisherDisplayName>Casultra</PublisherDisplayName>
    <Logo>Assets\StoreLogo.scale-100.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
    <!-- Python 3.12 / PyInstaller native DLLs need the VC runtime. -->
    <PackageDependency
      Name="Microsoft.VCLibs.140.00"
      MinVersion="14.0.30704.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="ScreenAnnotatorPro"
      Executable="ScreenAnnotatorPro.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Screen Annotator Pro"
        Description="Draw on your screen like a whiteboard, and record it with every annotation baked into the video."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.scale-100.png"
        Square44x44Logo="Assets\Square44x44Logo.scale-100.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.scale-100.png"
          Square310x310Logo="Assets\Square310x310Logo.scale-100.png"
          Square71x71Logo="Assets\Square71x71Logo.scale-100.png"
          ShortName="Annotator Pro" />
        <uap:SplashScreen Image="Assets\SplashScreen.scale-100.png" />
      </uap:VisualElements>
      <!--
        Start with Windows. A packaged app's writes to the HKCU Run key land in
        its private copy of the registry, which nothing reads at sign-in — so
        the old Run-key toggle did nothing in the Store build. The task starts
        disabled; Settings switches it with Windows.ApplicationModel.StartupTask
        (platform_win.py), and the user can also flip it in Settings → Apps →
        Startup. TaskId must match platform_win.STARTUP_TASK_ID.
      -->
      <Extensions>
        <uap5:Extension
          Category="windows.startupTask"
          Executable="ScreenAnnotatorPro.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask
            TaskId="ScreenAnnotatorProStartup"
            Enabled="false"
            DisplayName="Screen Annotator Pro" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
