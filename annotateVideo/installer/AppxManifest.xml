<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for Screen Annotator Pro — Video.

  Deliberately a DIFFERENT identity from the shipping Store package
  (Casultra.ScreenAnnotatorPro), so this build installs alongside it instead
  of replacing it. Test the recorder without losing the app you actually use.

  This is a sideload/test package: CI signs it with a self-signed certificate
  whose subject must match Publisher below exactly. For a Store submission you
  would upload the UNSIGNED .msix and let Partner Center sign it.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Casultra.ScreenAnnotatorProVideo"
    Publisher="CN=Casultra-Video-Dev"
    Version="4.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Screen Annotator Pro (Video)</DisplayName>
    <PublisherDisplayName>Casultra</PublisherDisplayName>
    <Logo>Assets\StoreLogo.scale-100.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
    <!-- Python 3.12 / PyInstaller native DLLs need the VC runtime. -->
    <PackageDependency
      Name="Microsoft.VCLibs.140.00"
      MinVersion="14.0.30704.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="ScreenAnnotatorProVideo"
      Executable="ScreenAnnotatorPro.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Screen Annotator Pro (Video)"
        Description="Draw on your screen and record it, with every annotation baked into the video."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.scale-100.png"
        Square44x44Logo="Assets\Square44x44Logo.scale-100.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.scale-100.png"
          Square310x310Logo="Assets\Square310x310Logo.scale-100.png"
          Square71x71Logo="Assets\Square71x71Logo.scale-100.png"
          ShortName="Annotator Video" />
        <uap:SplashScreen Image="Assets\SplashScreen.scale-100.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
